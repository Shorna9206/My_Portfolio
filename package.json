{
  "name": "rokeya-khatun-shorna-portfolio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm --prefix frontend/web install && npm --prefix frontend/admin install && npm --prefix backend install",
    "dev:web": "npm --prefix frontend/web run dev",
    "dev:admin": "npm --prefix frontend/admin run dev",
    "dev:api": "npm --prefix backend run dev",
    "build:web": "npm --prefix frontend/web run build",
    "build:admin": "npm --prefix frontend/admin run build",
    "build": "npm run build:web && npm run build:admin",
    "start:api": "npm --prefix backend start",
    "set-admin": "npm --prefix backend run set-admin --"
  }
}
